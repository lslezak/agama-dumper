{
  "name": "agama-dumper",
  "version": "0.0.1",
  "description": "Tool for dumping the Agama REST API data",
  "private": true,
  "license": "GPLv2",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "tsx src/agama-dumper.ts",
    "format": "prettier --write src",
    "clean": "rm -rf dist/*"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "agama-dumper": "./dist/agama-dumper.js",
    "agama-vm": "./dist/agama-vm.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/readline-sync": "^1.4.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "readline-sync": "^1.4.10"
  },
  "engines": {
    "node": ">=22"
  }
}
